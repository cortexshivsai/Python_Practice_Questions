# Import Math

# Import the math module
import math

# Take a number from the user
num = int(input("Enter a number: "))

# Calculate the square root
square_root = math.sqrt(num)

# Calculate the factorial
factorial = math.factorial(num)

# Calculate the power of the number
power = math.pow(num, 2)

# Display the results
print("Square root:", square_root)
print("Factorial:", factorial)
print("Square:", power)

# Round a number upward to the next integer
print("Ceiling of 4.3:", math.ceil(4.3))

# Round a number downward to the previous integer
print("Floor of 4.8:", math.floor(4.8))

"""
Example input: 5

Output:

Square root: 2.23606797749979
Factorial: 120
Square: 25.0
Ceiling of 4.3: 5
